{"language": "hi", "text": "भारत में अनेक भाषाएँ बोली जाती हैं।"}
{"language": "hi", "text": "मुझे कार्यालय जाने की आवश्यकता है।"}
{"language": "hi", "text": "ऑफिस की मीटिंग अगले हफ्ते होगी।"}
{"language": "hi", "text": "मुझे क़ानून की ज़रूरत है।"}
{"language": "hi", "text": "चाँदनी रात में ख़त आया।"}
{"language": "hi", "text": "बड़ा पेड़ और ग़रीब गाँव दोनों दिखे।"}
{"language": "sa", "text": "भारते अनेकाः भाषाः भाष्यन्ते।"}
{"language": "sa", "text": "अहं कार्यालयं गच्छामि।"}
{"language": "sa", "text": "धर्मो रक्षति रक्षितः॥"}
{"language": "sa", "text": "भारतं विशालं राष्ट्रम् अस्ति।"}
{"language": "sa", "text": "सः पुस्तकं पठति।"}
{"language": "sa", "text": "अस्माकं देशः विशालः अस्ति।"}
