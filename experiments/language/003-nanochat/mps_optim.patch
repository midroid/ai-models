 from torch import Tensor
 from nanochat.common import COMPUTE_DTYPE
 
+def _scalar_on(t: Tensor, device: torch.device) -> Tensor:
+    """Scalar on `device` for an MPS parameter.
+
+    These buffers stay on CPU so `fill_` can change the learning rate without
+    making `torch.compile` recapture the fused step. Eager MPS does not
+    promote a CPU scalar inside `lerp_`. The first call allocates one 0-D
+    tensor on the parameter device; later calls `copy_` into it.
+    """
+    if device.type != "mps" or t.device == device:
+        return t
+    cached = getattr(t, "_mps_scalar", None)
+    if cached is None or cached.device != device or cached.dtype != t.dtype:
+        cached = torch.empty((), dtype=t.dtype, device=device)
+        t._mps_scalar = cached
+    cached.copy_(t)
+    return cached
+
